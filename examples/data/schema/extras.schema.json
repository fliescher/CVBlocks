{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extras",
  "type": "object",
  "additionalProperties": false,
  "required": ["certifications", "open_source", "talks", "languages"],
  "properties": {
    "certifications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_source": {
      "type": "array",
      "items": { "type": "string" }
    },
    "talks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
