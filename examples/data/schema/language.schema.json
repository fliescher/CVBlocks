{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Language",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "language"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable slug, unique within languages/."
    },
    "language": { "type": "string" },
    "level": { "type": "string" }
  }
}
