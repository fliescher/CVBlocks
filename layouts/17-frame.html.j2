<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — Curriculum Vitae</title>
<style>
  :root {
    --accent: {{ theme.accent }};
    --highlight: {{ theme.highlight }};
    --ink: #1f2428;
    --muted: #626b73;
    --rule: #d6dade;
    --tint: #f1f3f5;
    --tint: color-mix(in srgb, var(--accent) 9%, #fff);
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.45; color: var(--ink); }
  .sheet { width: 210mm; min-height: 297mm; margin: 18px auto; background: #fff; box-shadow: 0 2px 14px rgba(0, 0, 0, .18); }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p { margin: 0; }
  ul { margin: 0; padding-left: 17px; }
  li { margin: 0 0 3px; }
  li.is-highlight { color: var(--highlight); font-weight: 600; }
  .plain { margin: 0; padding: 0; list-style: none; }
  @page { size: A4; margin: 0; }
  @media print {
    body { background: #fff; }
    .sheet { margin: 0; box-shadow: none; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }

  body { background: #e8e5df; font: 10.8pt/1.5 Georgia, "Times New Roman", serif; }
  .sheet { padding: 10mm; }
  .frame { min-height: calc(297mm - 20mm); padding: 11mm 13mm; border: 2px solid var(--accent); outline: 1px solid var(--accent); outline-offset: 3px; }
  header { text-align: center; }
  h1 { color: var(--accent); font-size: 29pt; font-weight: normal; letter-spacing: .08em; text-transform: uppercase; }
  .headline { margin-top: 2px; font-style: italic; color: var(--muted); font-size: 11.5pt; }
  .contact { display: flex; flex-wrap: wrap; justify-content: center; gap: 2px 14px; margin-top: 8px; color: var(--muted); font-size: 9.4pt; }
  h2 { display: flex; align-items: center; gap: 10px; margin: 18px 0 9px; color: var(--accent); font-size: 10pt; font-weight: bold; letter-spacing: .2em; text-transform: uppercase; }
  h2::before, h2::after { content: ""; flex: 1; border-top: 1px solid var(--accent); }
  .summary p { margin-bottom: 6px; text-align: justify; }
  .job { margin-bottom: 12px; break-inside: avoid; }
  .job-head { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; }
  .job h3 { font-size: 11.4pt; }
  .job h3 em { color: var(--muted); font-weight: normal; }
  .job-dates { color: var(--muted); font-size: 9.4pt; white-space: nowrap; }
  .scope { margin: 2px 0 4px; color: var(--muted); font-style: italic; font-size: 9.8pt; }
  .skill { margin: 0 0 3px; font-size: 10pt; text-align: center; }
  .skill b { color: var(--accent); margin-right: 6px; }
  .plain li { margin-bottom: 3px; font-size: 10pt; text-align: center; }
</style>
</head>
<body>
<div class="sheet"><div class="frame">
  <header><h1>{{ profile.name }}</h1><p class="headline">{{ profile.headline }}</p><div class="contact">{% for item in contact %}{% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}<span>{{ item.text }}</span>{% endif %}{% endfor %}</div></header>
  {% if profile.summary %}<section class="summary"><h2>Profile</h2>{% for para in profile.summary %}<p>{{ para }}</p>{% endfor %}</section>{% endif %}
  <section>
    <h2>Experience</h2>
    {% for role in roles %}
    <article class="job">
      <div class="job-head"><h3>{{ role.title }} <em>· {{ role.company }}</em></h3><div class="job-dates">{{ role.meta }}</div></div>
      {% if role.scope %}<p class="scope">{{ role.scope }}</p>{% endif %}
      <ul>{% for a in role.achievements %}<li{% if a.get('highlight') %} class="is-highlight"{% endif %}>{{ a.text }}</li>{% endfor %}</ul>
    </article>
    {% endfor %}
  </section>
  {% if skills.categories %}<section><h2>Skills</h2>{% for cat in skills.categories %}<p class="skill"><b>{{ cat.name }}</b><span>{{ cat['items'] | join(', ') }}</span></p>{% endfor %}</section>{% endif %}
  {% if education.entries %}<section><h2>Education</h2><ul class="plain">{% for entry in education.entries %}<li><b>{{ entry.degree }}</b><br>{{ entry.institution }}, {{ entry.year }}</li>{% endfor %}</ul></section>{% endif %}
  {% if extras_items %}<section><h2>Extras</h2><ul class="plain">{% if extras.certifications %}<li><b>Certifications:</b> {{ extras.certifications | join('; ') }}</li>{% endif %}{% if extras.open_source %}<li><b>Open source:</b> {{ extras.open_source | join('; ') }}</li>{% endif %}{% if extras.talks %}<li><b>Talks:</b> {{ extras.talks | join('; ') }}</li>{% endif %}{% if extras.languages %}<li><b>Languages:</b> {{ extras.languages | join(', ') }}</li>{% endif %}</ul></section>{% endif %}
</div></div>
</body>
</html>
