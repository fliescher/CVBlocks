<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — Curriculum Vitae</title>
<style>
  :root {
    --accent: {{ theme.accent }};
    --highlight: {{ theme.highlight }};
    --ink: #1c1c1c;
    --muted: #5f5f5f;
    --rule: #b9b9b9;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: #e8e6e0;
    color: var(--ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 11.5pt;
    line-height: 1.45;
  }
  .sheet {
    width: 210mm;
    min-height: 297mm;
    margin: 18px auto;
    padding: 18mm 20mm;
    background: #fff;
    box-shadow: 0 2px 14px rgba(0, 0, 0, .18);
  }
  header {
    text-align: center;
    border-bottom: 3px double var(--accent);
    padding-bottom: 12px;
  }
  .name {
    margin: 0 0 4px;
    color: var(--accent);
    font-size: 32pt;
    font-weight: normal;
    letter-spacing: .10em;
    text-transform: uppercase;
  }
  .headline {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 10pt;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .contact { font-size: 9.5pt; color: var(--muted); }
  .contact > * + *::before { content: " · "; color: var(--rule); }
  .contact a { color: var(--muted); text-decoration: none; }
  h2 {
    margin: 18px 0 8px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--rule);
    color: var(--accent);
    font-size: 10pt;
    font-weight: bold;
    letter-spacing: .18em;
    text-transform: uppercase;
  }
  .summary p { margin: 0 0 6px; text-align: justify; }
  .job { margin: 0 0 14px; break-inside: avoid; }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .job-title { font-weight: bold; }
  .job-title em { color: var(--muted); font-style: italic; font-weight: normal; }
  .job-dates { color: var(--muted); font-size: 9.5pt; white-space: nowrap; }
  .scope { margin: 2px 0 4px; color: var(--muted); font-size: 9.8pt; font-style: italic; }
  ul { margin: 0; padding-left: 17px; }
  li { margin: 0 0 3px; }
  li.is-highlight { color: var(--highlight); font-weight: bold; }
  .skill-row { margin: 0 0 4px; font-size: 9.8pt; }
  .skill-row b { color: var(--accent); }
  .plain-list { margin: 0; padding: 0; list-style: none; }
  .plain-list li { margin: 0 0 3px; font-size: 9.8pt; }
  .label { color: var(--accent); font-weight: bold; }
  @page { size: A4; margin: 18mm 20mm; }
  @media print {
    body { background: #fff; }
    .sheet { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
  }
</style>
</head>
<body>
<main class="sheet">
  <header>
    <h1 class="name">{{ profile.name }}</h1>
    <p class="headline">{{ profile.headline }}</p>
    <div class="contact">
      {% for item in contact %}{% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}<span>{{ item.text }}</span>{% endif %}{% endfor %}
    </div>
  </header>

  {% if profile.summary %}
  <section aria-labelledby="summary">
    <h2 id="summary">Profile</h2>
    <div class="summary">
      {% for para in profile.summary %}<p>{{ para }}</p>{% endfor %}
    </div>
  </section>
  {% endif %}

  <section aria-labelledby="experience">
    <h2 id="experience">Experience</h2>
    {% for role in roles %}
    <article class="job">
      <div class="job-head">
        <div class="job-title">{{ role.title }} <em>· {{ role.company }}</em></div>
        <div class="job-dates">{{ role.meta }}</div>
      </div>
      {% if role.scope %}<p class="scope">{{ role.scope }}</p>{% endif %}
      <ul>
        {% for a in role.achievements %}<li{% if a.get('highlight') %} class="is-highlight"{% endif %}>{{ a.text }}</li>{% endfor %}
      </ul>
    </article>
    {% endfor %}
  </section>

  {% if skills.categories %}
  <section aria-labelledby="skills">
    <h2 id="skills">Skills</h2>
    {% for cat in skills.categories %}
    <p class="skill-row"><b>{{ cat.name }}:</b> {{ cat['items'] | join(', ') }}</p>
    {% endfor %}
  </section>
  {% endif %}

  {% if education.entries %}
  <section aria-labelledby="education">
    <h2 id="education">Education</h2>
    <ul class="plain-list">
      {% for entry in education.entries %}
      <li><b>{{ entry.degree }}</b>, {{ entry.institution }} — {{ entry.year }}{% if entry.get('location') %} · {{ entry.location }}{% endif %}</li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if extras_items %}
  <section aria-labelledby="extras">
    <h2 id="extras">Selected Extras</h2>
    <ul class="plain-list">
      {% if extras.certifications %}<li><span class="label">Certifications:</span> {{ extras.certifications | join('; ') }}</li>{% endif %}
      {% if extras.open_source %}<li><span class="label">Open source:</span> {{ extras.open_source | join('; ') }}</li>{% endif %}
      {% if extras.projects %}<li><span class="label">Projects:</span> {{ extras.projects | join('; ') }}</li>{% endif %}
      {% if extras.hobbies %}<li><span class="label">Hobbies:</span> {{ extras.hobbies | join('; ') }}</li>{% endif %}
      {% if extras.talks %}<li><span class="label">Talks:</span> {{ extras.talks | join('; ') }}</li>{% endif %}
      {% if extras.languages %}<li><span class="label">Languages:</span> {{ extras.languages | join(', ') }}</li>{% endif %}
    </ul>
  </section>
  {% endif %}
</main>
</body>
</html>
