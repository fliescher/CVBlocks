<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — Curriculum Vitae</title>
<style>
  :root {
    --accent: {{ theme.accent }};
    --highlight: {{ theme.highlight }};
    --ink: #1f2428;
    --muted: #626b73;
    --rule: #d6dade;
    --tint: #f1f3f5;
    --tint: color-mix(in srgb, var(--accent) 9%, #fff);
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.45; color: var(--ink); }
  .sheet { width: 210mm; min-height: 297mm; margin: 18px auto; background: #fff; box-shadow: 0 2px 14px rgba(0, 0, 0, .18); }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p { margin: 0; }
  ul { margin: 0; padding-left: 17px; }
  li { margin: 0 0 3px; }
  li.is-highlight { color: var(--highlight); font-weight: 600; }
  .plain { margin: 0; padding: 0; list-style: none; }
  @page { size: A4; margin: 0; }
  @media print {
    body { background: #fff; }
    .sheet { margin: 0; box-shadow: none; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }

  body { background: #e6e6e6; font: 10pt/1.5 "Helvetica Neue", Helvetica, Arial, sans-serif; }
  .sheet { padding: 16mm 16mm 14mm; }
  header { display: grid; grid-template-columns: 38mm 1fr; column-gap: 8mm; margin-bottom: 14px; }
  .mark { width: 14mm; height: 14mm; background: var(--accent); }
  h1 { font-size: 36pt; line-height: .98; font-weight: 800; letter-spacing: -.03em; }
  .headline { margin-top: 8px; font-size: 12pt; color: var(--accent); font-weight: 600; }
  .contact { display: flex; flex-wrap: wrap; gap: 2px 14px; margin-top: 10px; color: var(--muted); font-size: 9pt; }
  .row { display: grid; grid-template-columns: 38mm 1fr; column-gap: 8mm; padding: 11px 0; border-top: 2px solid var(--ink); }
  .row h2 { font-size: 8.6pt; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
  .summary p { margin-bottom: 6px; }
  .job { margin-bottom: 12px; break-inside: avoid; }
  .job:last-child { margin-bottom: 0; }
  .job-head { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; }
  .job h3 { font-size: 10.8pt; font-weight: 700; }
  .job-dates { color: var(--muted); font-size: 8.8pt; white-space: nowrap; }
  .co { color: var(--accent); font-weight: 600; font-size: 9.6pt; }
  .scope { margin: 2px 0 4px; color: var(--muted); font-size: 9.2pt; }
  .skill { margin: 0 0 3px; font-size: 9.4pt; }
  .skill b { margin-right: 6px; }
  .row .plain li { margin-bottom: 3px; font-size: 9.4pt; }
</style>
</head>
<body>
<div class="sheet">
  <header>
    <div class="mark"></div>
    <div><h1>{{ profile.name }}</h1><p class="headline">{{ profile.headline }}</p><div class="contact">{% for item in contact %}{% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}<span>{{ item.text }}</span>{% endif %}{% endfor %}</div></div>
  </header>
  {% if profile.summary %}<section class="row"><h2>Profile</h2><div class="summary">{% for para in profile.summary %}<p>{{ para }}</p>{% endfor %}</div></section>{% endif %}
  <section class="row">
    <h2>Experience</h2>
    <div>
      {% for role in roles %}
      <article class="job">
        <div class="job-head"><h3>{{ role.title }}</h3><div class="job-dates">{{ role.meta }}</div></div>
        <div class="co">{{ role.company }}</div>
        {% if role.scope %}<p class="scope">{{ role.scope }}</p>{% endif %}
        <ul>{% for a in role.achievements %}<li{% if a.get('highlight') %} class="is-highlight"{% endif %}>{{ a.text }}</li>{% endfor %}</ul>
      </article>
      {% endfor %}
    </div>
  </section>
  {% if skills.categories %}<section class="row"><h2>Skills</h2><div>{% for cat in skills.categories %}<p class="skill"><b>{{ cat.name }}</b><span>{{ cat['items'] | join(', ') }}</span></p>{% endfor %}</div></section>{% endif %}
  {% if education.entries %}<section class="row"><h2>Education</h2><ul class="plain">{% for entry in education.entries %}<li><b>{{ entry.degree }}</b><br>{{ entry.institution }}, {{ entry.year }}</li>{% endfor %}</ul></section>{% endif %}
  {% if extras_items %}<section class="row"><h2>Extras</h2><ul class="plain">{% if extras.certifications %}<li><b>Certifications:</b> {{ extras.certifications | join('; ') }}</li>{% endif %}{% if extras.open_source %}<li><b>Open source:</b> {{ extras.open_source | join('; ') }}</li>{% endif %}{% if extras.talks %}<li><b>Talks:</b> {{ extras.talks | join('; ') }}</li>{% endif %}{% if extras.languages %}<li><b>Languages:</b> {{ extras.languages | join(', ') }}</li>{% endif %}</ul></section>{% endif %}
</div>
</body>
</html>
