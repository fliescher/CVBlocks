<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — {{ "Cover Letter" if cover_letter else "Curriculum Vitae" }}</title>
<style>
  :root {
    --accent: {{ theme.accent }};
    --highlight: {{ theme.highlight }};
    --ink: #1f2428;
    --muted: #626b73;
    --rule: #d6dade;
    --tint: #f1f3f5;
    --tint: color-mix(in srgb, var(--accent) 9%, #fff);
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.45; color: var(--ink); }
  .sheet { width: 210mm; min-height: 297mm; margin: 18px auto; background: #fff; box-shadow: 0 2px 14px rgba(0, 0, 0, .18); }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p { margin: 0; }
  ul { margin: 0; padding-left: 17px; }
  li { margin: 0 0 3px; }
  li.is-highlight { color: var(--highlight); font-weight: 600; }
  .plain { margin: 0; padding: 0; list-style: none; }
  @page { size: A4; margin: 0; }
  @media print {
    body { background: #fff; }
    .sheet { margin: 0; box-shadow: none; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }

  body { background: #e5e7ea; font: 10.4pt/1.45 "Segoe UI", "Helvetica Neue", Arial, sans-serif; }
  .sheet { padding: 15mm 17mm; }
  header { display: flex; justify-content: space-between; align-items: flex-end; gap: 12mm; padding-bottom: 10px; border-bottom: 4px solid var(--accent); }
  h1 { font-size: 27pt; line-height: 1.05; font-weight: 700; letter-spacing: -.01em; }
  .headline { margin-top: 3px; color: var(--accent); font-size: 11.5pt; font-weight: 600; }
  .contact { display: flex; flex-direction: column; align-items: flex-end; font-size: 9pt; color: var(--muted); }
  h2 { display: flex; align-items: center; gap: 8px; margin: 18px 0 8px; font-size: 10.5pt; letter-spacing: .14em; text-transform: uppercase; }
  h2::before { content: ""; width: 9px; height: 9px; background: var(--accent); }
  .summary p { margin-bottom: 6px; }
  .job { margin-bottom: 13px; break-inside: avoid; }
  .job-head { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; }
  .job h3 { font-size: 11.2pt; }
  .job h3 span { color: var(--accent); }
  .job-dates { color: var(--muted); font-size: 9pt; white-space: nowrap; }
  .scope { margin: 2px 0 4px; color: var(--muted); font-size: 9.4pt; }
  ul { list-style: square; }
  li::marker { color: var(--accent); }
  .plain { list-style: none; }
  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px 12px; }
  .skill { font-size: 9.3pt; }
  .skill b { display: block; color: var(--accent); }
  .two { display: grid; grid-template-columns: 1fr 1fr; column-gap: 12mm; }
  .two .plain li { font-size: 9.4pt; }
</style>
</head>
<body>
<div class="sheet">
  <header>
    <div><h1>{{ profile.name }}</h1><p class="headline">{{ profile.headline }}</p></div>
    <div class="contact">{% for item in contact %}{% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}<span>{{ item.text }}</span>{% endif %}{% endfor %}</div>
  </header>

  {% if cover_letter %}
  {{ cover_letter_html | safe }}
  {% else %}
  {% if profile.summary %}<section class="summary"><h2>Profile</h2>{% for para in profile.summary %}<p>{{ para }}</p>{% endfor %}</section>{% endif %}
  <section>
    <h2>Experience</h2>
    {% for role in roles %}
    <article class="job">
      <div class="job-head"><h3>{{ role.title }} <span>· {{ role.company }}</span></h3><div class="job-dates">{{ role.meta }}</div></div>
      {% if role.scope %}<p class="scope">{{ role.scope }}</p>{% endif %}
      <ul>{% for a in role.achievements %}<li{% if a.get('highlight') %} class="is-highlight"{% endif %}>{{ a.text }}</li>{% endfor %}</ul>
    </article>
    {% endfor %}
  </section>
  {% if skills.categories %}<section><h2>Skills</h2><div class="skills">{% for cat in skills.categories %}<p class="skill"><b>{{ cat.name }}</b><span>{{ cat['items'] | join(', ') }}</span></p>{% endfor %}</div></section>{% endif %}
  <div class="two">
    {% if education.entries %}<section><h2>Education</h2><ul class="plain">{% for entry in education.entries %}<li><b>{{ entry.degree }}</b><br>{{ entry.institution }}, {{ entry.year }}</li>{% endfor %}</ul></section>{% endif %}
    {% if extras_items %}<section><h2>Extras</h2><ul class="plain">{% if extras.certifications %}<li><b>Certifications:</b> {{ extras.certifications | join('; ') }}</li>{% endif %}{% if extras.open_source %}<li><b>Open source:</b> {{ extras.open_source | join('; ') }}</li>{% endif %}{% if extras.projects %}<li><b>Projects:</b> {{ extras.projects | join('; ') }}</li>{% endif %}{% if extras.hobbies %}<li><b>Hobbies:</b> {{ extras.hobbies | join('; ') }}</li>{% endif %}{% if extras.talks %}<li><b>Talks:</b> {{ extras.talks | join('; ') }}</li>{% endif %}{% if extras.languages %}<li><b>Languages:</b> {{ extras.languages | join(', ') }}</li>{% endif %}</ul></section>{% endif %}
  </div>
  {% endif %}
</div>
</body>
</html>
