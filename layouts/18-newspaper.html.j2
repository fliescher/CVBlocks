<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — Curriculum Vitae</title>
<style>
  :root {
    --accent: {{ theme.accent }};
    --highlight: {{ theme.highlight }};
    --ink: #1f2428;
    --muted: #626b73;
    --rule: #d6dade;
    --tint: #f1f3f5;
    --tint: color-mix(in srgb, var(--accent) 9%, #fff);
  }
  * { box-sizing: border-box; }
  body { margin: 0; line-height: 1.45; color: var(--ink); }
  .sheet { width: 210mm; min-height: 297mm; margin: 18px auto; background: #fff; box-shadow: 0 2px 14px rgba(0, 0, 0, .18); }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p { margin: 0; }
  ul { margin: 0; padding-left: 17px; }
  li { margin: 0 0 3px; }
  li.is-highlight { color: var(--highlight); font-weight: 600; }
  .plain { margin: 0; padding: 0; list-style: none; }
  @page { size: A4; margin: 0; }
  @media print {
    body { background: #fff; }
    .sheet { margin: 0; box-shadow: none; }
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }

  body { background: #e7e4dc; font: 10pt/1.42 Georgia, "Times New Roman", serif; }
  .sheet { padding: 13mm 15mm; }
  .masthead { text-align: center; border-top: 4px double var(--ink); border-bottom: 4px double var(--ink); padding: 8px 0 7px; }
  h1 { font-size: 36pt; line-height: 1; font-weight: normal; letter-spacing: .06em; text-transform: uppercase; color: var(--accent); }
  .dateline { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 3px; margin: 5px 0 12px; padding-bottom: 5px; border-bottom: 1px solid var(--ink); font-size: 8.8pt; letter-spacing: .1em; text-transform: uppercase; }
  .dateline .headline { font-weight: bold; color: var(--accent); }
  .dateline > span:last-child { display: flex; flex-wrap: wrap; justify-content: center; gap: 2px 12px; }
  h2 { margin: 0 0 7px; padding-bottom: 2px; border-bottom: 1px solid var(--ink); font-size: 9.4pt; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); }
  section { margin-bottom: 14px; }
  .summary p { margin-bottom: 5px; text-align: justify; }
  .summary p:first-child::first-letter { float: left; margin: 2px 6px 0 0; font-size: 30pt; line-height: .85; color: var(--accent); }
  .cols { columns: 2; column-gap: 9mm; column-rule: 1px solid var(--rule); }
  .job { margin-bottom: 11px; break-inside: avoid; }
  .job h3 { font-size: 10.6pt; }
  .job-meta { color: var(--muted); font-size: 8.8pt; font-style: italic; }
  .job-meta b { color: var(--accent); font-style: normal; }
  .scope { margin: 2px 0 3px; font-size: 9pt; color: var(--muted); }
  ul { padding-left: 14px; }
  li { text-align: justify; }
  .three { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 8mm; }
  .skill { margin: 0 0 4px; font-size: 9pt; }
  .skill b { display: block; color: var(--accent); }
  .three .plain li { font-size: 9pt; }
</style>
</head>
<body>
<div class="sheet">
  <header>
    <div class="masthead"><h1>{{ profile.name }}</h1></div>
    <div class="dateline"><span class="headline">{{ profile.headline }}</span><span>{% for item in contact %}{% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}<span>{{ item.text }}</span>{% endif %}{% endfor %}</span></div>
  </header>
  {% if profile.summary %}<section class="summary">{% for para in profile.summary %}<p>{{ para }}</p>{% endfor %}</section>{% endif %}
  <section>
    <h2>Experience</h2>
    <div class="cols">
      {% for role in roles %}
      <article class="job">
        <h3>{{ role.title }}</h3>
        <div class="job-meta"><b>{{ role.company }}</b> · {{ role.meta }}</div>
        {% if role.scope %}<p class="scope">{{ role.scope }}</p>{% endif %}
        <ul>{% for a in role.achievements %}<li{% if a.get('highlight') %} class="is-highlight"{% endif %}>{{ a.text }}</li>{% endfor %}</ul>
      </article>
      {% endfor %}
    </div>
  </section>
  <div class="three">
    {% if skills.categories %}<section><h2>Skills</h2>{% for cat in skills.categories %}<p class="skill"><b>{{ cat.name }}</b><span>{{ cat['items'] | join(', ') }}</span></p>{% endfor %}</section>{% endif %}
    {% if education.entries %}<section><h2>Education</h2><ul class="plain">{% for entry in education.entries %}<li><b>{{ entry.degree }}</b><br>{{ entry.institution }}, {{ entry.year }}</li>{% endfor %}</ul></section>{% endif %}
    {% if extras_items %}<section><h2>Extras</h2><ul class="plain">{% if extras.certifications %}<li><b>Certifications:</b> {{ extras.certifications | join('; ') }}</li>{% endif %}{% if extras.open_source %}<li><b>Open source:</b> {{ extras.open_source | join('; ') }}</li>{% endif %}{% if extras.talks %}<li><b>Talks:</b> {{ extras.talks | join('; ') }}</li>{% endif %}{% if extras.languages %}<li><b>Languages:</b> {{ extras.languages | join(', ') }}</li>{% endif %}</ul></section>{% endif %}
  </div>
</div>
</body>
</html>
