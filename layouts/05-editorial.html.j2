<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ profile.name }} — CV</title>
<style>
  :root {
    --accent: {{ theme.accent }};
    --highlight: {{ theme.highlight }};
    --ink: #201d1a;
    --muted: #6d665f;
    --rule: #cfc7bd;
    --paper: #fbf8f3;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: #e8e2d9;
    color: var(--ink);
    font-family: Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-size: 10.8pt;
    line-height: 1.48;
  }
  .sheet {
    width: 210mm;
    min-height: 297mm;
    margin: 18px auto;
    padding: 20mm 22mm;
    background: var(--paper);
    box-shadow: 0 2px 14px rgba(0, 0, 0, .18);
  }
  header {
    padding: 8px 0 14px;
    border-top: 4px solid var(--accent);
    border-bottom: 1px solid var(--rule);
  }
  .kicker {
    margin: 0 0 6px;
    color: var(--accent);
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 8pt;
    letter-spacing: .24em;
    text-transform: uppercase;
  }
  .name {
    margin: 0;
    font-size: 40pt;
    font-weight: normal;
    letter-spacing: -.035em;
    line-height: .95;
  }
  .headline {
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 13pt;
    font-style: italic;
  }
  .contact {
    margin-top: 12px;
    color: var(--muted);
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 8pt;
    letter-spacing: .04em;
  }
  .contact > * + *::before { content: "  /  "; color: var(--rule); }
  .contact a { color: var(--muted); text-decoration: none; }
  .lede {
    margin: 16px 0 18px;
    padding-left: 14px;
    border-left: 3px solid var(--accent);
    font-size: 14pt;
    line-height: 1.4;
  }
  .lede p { margin: 0 0 6px; }
  .lede p:last-child { margin: 0; }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 20px 0 10px;
    color: var(--accent);
    font-family: "Helvetica Neue", Arial, sans-serif;
    font-size: 9pt;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  h2 span { color: var(--rule); font-size: 8pt; }
  h2::after { content: ""; flex: 1; border-bottom: 1px solid var(--rule); }
  .job {
    display: grid;
    grid-template-columns: 31mm 1fr;
    gap: 7mm;
    margin: 0 0 14px;
    break-inside: avoid;
  }
  .when { color: var(--muted); font-size: 9pt; font-style: italic; text-align: right; padding-top: 2px; }
  .when b { display: block; color: var(--ink); font-style: normal; font-weight: normal; }
  .job-title { margin: 0; font-size: 13pt; }
  .job-title span { color: var(--muted); font-style: italic; }
  .scope { margin: 1px 0 4px; color: var(--muted); font-size: 9.5pt; }
  ul { margin: 0; padding-left: 16px; }
  li { margin: 0 0 3px; }
  li.is-highlight { color: var(--highlight); font-weight: bold; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 4mm 12mm; }
  .two p { margin: 0 0 5px; font-size: 9.5pt; }
  .two b { color: var(--accent); font-family: "Helvetica Neue", Arial, sans-serif; font-size: 8pt; letter-spacing: .08em; text-transform: uppercase; }
  .plain { margin: 0; padding: 0; list-style: none; font-size: 9.5pt; }
  .plain li { margin: 0 0 4px; }
  @page { size: A4; margin: 20mm 22mm; }
  @media print {
    body { background: #fff; }
    .sheet { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
  }
</style>
</head>
<body>
<main class="sheet">
  <header>
    <p class="kicker">Curriculum Vitae</p>
    <h1 class="name">{{ profile.name }}</h1>
    <p class="headline">{{ profile.headline }}</p>
    <div class="contact">
      {% for item in contact %}{% if item.href %}<a href="{{ item.href }}">{{ item.text }}</a>{% else %}<span>{{ item.text }}</span>{% endif %}{% endfor %}
    </div>
  </header>

  {% if profile.summary %}
  <section class="lede">
    {% for para in profile.summary %}<p>{{ para }}</p>{% endfor %}
  </section>
  {% endif %}

  <section>
    <h2><span>01</span> Experience</h2>
    {% for role in roles %}
    <article class="job">
      <div class="when"><b>{{ role.start | month }} – {{ role.end | month }}</b>{{ role.company }}{% if role.location %}<br>{{ role.location }}{% endif %}</div>
      <div>
        <h3 class="job-title">{{ role.title }} <span>· {{ role.company }}</span></h3>
        {% if role.scope %}<p class="scope">{{ role.scope }}</p>{% endif %}
        <ul>
          {% for a in role.achievements %}<li{% if a.get('highlight') %} class="is-highlight"{% endif %}>{{ a.text }}</li>{% endfor %}
        </ul>
      </div>
    </article>
    {% endfor %}
  </section>

  {% if skills.categories %}
  <section>
    <h2><span>02</span> Skills</h2>
    <div class="two">
      {% for cat in skills.categories %}
      <p><b>{{ cat.name }}</b><br>{{ cat['items'] | join(', ') }}</p>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section>
    <h2><span>03</span> Education &amp; Extras</h2>
    <div class="two">
      <div>
        <ul class="plain">
          {% for entry in education.entries %}
          <li><b>{{ entry.degree }}</b><br>{{ entry.institution }}, {{ entry.year }}</li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <ul class="plain">
          {% if extras.certifications %}<li>{{ extras.certifications | join('; ') }}</li>{% endif %}
          {% if extras.open_source %}<li>{{ extras.open_source | join('; ') }}</li>{% endif %}
          {% if extras.talks %}<li>{{ extras.talks | join('; ') }}</li>{% endif %}
          {% if extras.languages %}<li>{{ extras.languages | join(', ') }}</li>{% endif %}
        </ul>
      </div>
    </div>
  </section>
</main>
</body>
</html>
