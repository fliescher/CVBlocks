{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification or training",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable slug, unique within certifications/."
    },
    "title": { "type": "string" },
    "issuer": { "type": "string" },
    "year": { "type": "string" },
    "kind": { "type": "string", "enum": ["certification", "training"] },
    "url": { "type": "string" }
  }
}
