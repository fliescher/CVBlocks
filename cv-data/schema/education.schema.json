{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Education",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["degree", "institution", "year"],
        "properties": {
          "degree": { "type": "string" },
          "institution": { "type": "string" },
          "year": { "type": "string" },
          "location": { "type": "string" }
        }
      }
    }
  }
}
